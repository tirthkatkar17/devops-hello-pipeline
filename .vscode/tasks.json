{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Hello App",
            "type": "shell",
            "command": "python hello.py",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Run Pytest",
            "type": "shell",
            "command": "pytest -v",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Docker Build",
            "type": "shell",
            "command": "docker build -t hello-python .",
            "group": "build"
        },
        {
            "label": "Docker Run",
            "type": "shell",
            "command": "docker run --rm hello-python",
            "group": "none"
        },
        {
            "label": "Run Evidently Monitor",
            "type": "shell",
            "command": "python monitor.py",
            "group": "none"
        }
    ]
}
